{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chud Clone",
  "version": "0.9.0",
  "identifier": "app.chudclone.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chud Clone",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "maximized": true,
        "backgroundColor": "#05060d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
